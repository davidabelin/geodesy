            <name>AN → OtrB</name>
            <description>
                
        
<![CDATA[
          <b>P1:</b> AN<br>
          <b>P2:</b> OtrB<br>
          <hr>
          <b>Distance:</b> 3.757 miles<br>
          <hr>
          <u>Path P1 → P2:</u><br>
          <b>Forward Azimuth at P1 (Az12):</b> 315.031°<br>
          <b>Back Azimuth at P2 (BackAz12):</b> 315.000°<br>
          <hr>
          <u>Path P2 → P1:</u><br>
          <b>Forward Azimuth at P2 (Az21):</b> 135.000°<br>
          <b>Back Azimuth at P1 (BackAz21):</b> 135.031°<br>
          <hr>
          <b>Filter Reason(s):</b> Az21 Whole, Az21 multiple:15.00<br>
          <hr>
          <i>Calculation Method: Spherical</i>
        ]]>                
        
            </description>
