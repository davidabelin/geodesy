        <Placemark id="7">
            <name>AN → H39</name>
            <description>
                
        
<![CDATA[
          <b>P1:</b> AN<br>
          <b>P2:</b> H39<br>
          <hr>
          <b>Distance:</b> 16.148 miles<br>
          <hr>
          <u>Path P1 → P2:</u><br>
          <b>Forward Azimuth at P1 (Az12):</b> 270.188°<br>
          <b>Back Azimuth at P2 (BackAz12):</b> 270.000°<br>
          <hr>
          <u>Path P2 → P1:</u><br>
          <b>Forward Azimuth at P2 (Az21):</b> 90.000°<br>
